import Adw from 'gi://Adw';
import Gio from 'gi://Gio';
import Gtk from 'gi://Gtk';
import { ExtensionPreferences, gettext as _ } from 'resource:///org/gnome/Shell/Extensions/js/extensions/prefs.js';

function normalizeShortcutValue(value) {
    const raw = String(value || 'super+alt').trim().toLowerCase();
    if (!raw) {
        return 'super+alt';
    }

    const aliases = {
        'windows': 'super',
        'super': 'super',
        'meta': 'super',
        'cmd': 'super',
        'ctrl': 'ctrl',
        'control': 'ctrl',
        'alt': 'alt',
        'shift': 'shift',
        'super-alt': 'super+alt',
        'ctrl-super': 'ctrl+super',
    };

    const normalized = raw
        .replace(/[_\s-]+/g, '+')
        .replace(/\++/g, '+')
        .replace(/^\+|\+$/g, '')
        .split('+')
        .map(part => aliases[part] || part)
        .filter(Boolean);

    const unique = [];
    normalized.forEach(part => {
        if (!unique.includes(part)) {
            unique.push(part);
        }
    });

    return unique.length ? unique.join('+') : 'super+alt';
}

export default class ZoomByScrollPreferences extends ExtensionPreferences {
    fillPreferencesWindow(window) {
        const settings = this.getSettings();

        const page = new Adw.PreferencesPage();
        window.add(page);

        const group = new Adw.PreferencesGroup({
            title: _('Shortcuts'),
            description: _('Set the modifier combination used while scrolling to zoom'),
        });
        page.add(group);

        const presetOptions = [
            ['Super + Alt', 'super+alt'],
            ['Ctrl + Super', 'ctrl+super'],
            ['Shift + Alt', 'shift+alt'],
            ['Alt', 'alt'],
            ['Custom', 'custom'],
        ];

        const shortcutPresetRow = new Adw.ComboRow({
            title: _('Activation Shortcut'),
            subtitle: _('Choose a preset or define your own custom combination'),
            model: new Gtk.StringList({
                strings: presetOptions.map(([label]) => label),
            }),
        });
        group.add(shortcutPresetRow);

        const customShortcutRow = new Adw.EntryRow({
            title: _('Custom Shortcut'),
            text: normalizeShortcutValue(settings.get_string('modifier-key')),
            show_apply_button: false,
        });
        customShortcutRow.set_placeholder('super+alt');
        group.add(customShortcutRow);

        const currentValue = normalizeShortcutValue(settings.get_string('modifier-key'));
        let selectedPreset = presetOptions.findIndex(([, value]) => value === currentValue);

        if (selectedPreset === -1) {
            selectedPreset = presetOptions.length - 1;
            customShortcutRow.set_text(currentValue);
        }

        shortcutPresetRow.set_selected(selectedPreset);
        customShortcutRow.set_visible(selectedPreset === presetOptions.length - 1);

        function updateSettingFromUi() {
            const selectedIndex = shortcutPresetRow.get_selected();
            if (selectedIndex === -1) {
                return;
            }

            if (selectedIndex === presetOptions.length - 1) {
                const customValue = normalizeShortcutValue(customShortcutRow.get_text());
                settings.set_string('modifier-key', customValue);
                return;
            }

            const [, value] = presetOptions[selectedIndex];
            settings.set_string('modifier-key', value);
            customShortcutRow.set_text(value);
        }

        shortcutPresetRow.connect('notify::selected', () => {
            const selectedIndex = shortcutPresetRow.get_selected();
            customShortcutRow.set_visible(selectedIndex === presetOptions.length - 1);
            updateSettingFromUi();
        });

        customShortcutRow.connect('notify::text', () => {
            if (shortcutPresetRow.get_selected() === presetOptions.length - 1) {
                updateSettingFromUi();
            }
        });

        const behaviorGroup = new Adw.PreferencesGroup({
            title: _('Zoom Behavior'),
            description: _('Configure zoom speed and sensitivity'),
        });
        page.add(behaviorGroup);

        const zoomStepRow = new Adw.SpinRow({
            title: _('Zoom Step (Sensitivity)'),
            subtitle: _('How much each scroll wheel tick changes the zoom level'),
            adjustment: new Gtk.Adjustment({
                value: settings.get_double('zoom-step'),
                lower: 0.01,
                upper: 1.0,
                step_increment: 0.05,
                page_increment: 0.1,
            }),
            digits: 2,
        });
        behaviorGroup.add(zoomStepRow);

        settings.bind(
            'zoom-step',
            zoomStepRow,
            'value',
            Gio.SettingsBindFlags.DEFAULT
        );

        const smoothZoomRow = new Adw.SwitchRow({
            title: _('Smooth Zoom'),
            subtitle: _('Enable animation for smoother transitions (may cause lag on slow hardware)'),
        });
        behaviorGroup.add(smoothZoomRow);

        settings.bind(
            'smooth-zoom',
            smoothZoomRow,
            'active',
            Gio.SettingsBindFlags.DEFAULT
        );
    }
}
